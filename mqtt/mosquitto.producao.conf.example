# EXEMPLO (não testado neste trabalho) de requisitos mínimos para implantação.
# TLS obrigatório, autenticação por senha e ACL por dispositivo.
listener 8883
cafile   /mosquitto/certs/ca.crt
certfile /mosquitto/certs/server.crt
keyfile  /mosquitto/certs/server.key
tls_version tlsv1.2
require_certificate false
allow_anonymous false
password_file /mosquitto/config/passwd
acl_file      /mosquitto/config/acl
persistence true
persistence_location /mosquitto/data/

# Arquivo acl (exemplo): cada dispositivo só publica no próprio ramo
#   pattern write residuos/dispositivos/%u/#
#   pattern read  residuos/dispositivos/%u/comandos
#   user plataforma
#   topic read residuos/#
#   topic write residuos/dispositivos/+/comandos
